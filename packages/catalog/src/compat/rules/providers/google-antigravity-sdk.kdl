// Catalog entry for "google-antigravity-sdk": Official Google Antigravity
// Python SDK (`google-antigravity`) authenticated via Gemini API key,
// Vertex AI (API key / ADC), or offline LiteRT-LM (Gemma 4).
provider "google-antigravity-sdk" {
	default-model "gemini-4-hydrogen"
	env "GEMINI_API_KEY"
	allow-unauthenticated #true
	requires-native-tools #true

	seed api="antigravity-sdk" base-url="https://generativelanguage.googleapis.com/v1beta" bundle="never" {
		model "gemini-4-hydrogen" name="Gemini 4 Hydrogen (Antigravity SDK)" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1048576 max-tokens=262144
			supports-tools #true
		}
		model "gemini-4-neon" name="Gemini 4 Neon (Antigravity SDK)" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1048576 max-tokens=262144
			supports-tools #true
		}
		model "gemini-4-carbon" name="Gemini 4 Carbon (Antigravity SDK)" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1048576 max-tokens=262144
			supports-tools #true
		}
		model "gemini-3.8-flash" name="Gemini 3.8 Flash (Antigravity SDK)" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1048576 max-tokens=65536
			supports-tools #true
		}
		model "gemma-4-26b-litert" name="Gemma 4 26B LiteRT (Offline)" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=65536 max-tokens=16384
			supports-tools #true
		}
	}

	models "gemini-4-hydrogen" "gemini-4-neon" {
		thinking-mode "google-level"
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-default-level "high"
	}
	models "gemini-4-carbon" "gemini-3.8-flash" {
		thinking-mode "google-level"
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-default-level "medium"
	}
	models "gemma-4-26b-litert" {
		thinking-mode "effort"
		thinking-efforts "low" "medium" "high"
		thinking-default-level "medium"
	}
}
